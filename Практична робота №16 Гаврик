#include <iostream>
#include <cstdlib>
#include <ctime>

using namespace std;

// 4. Функція для виводу масиву float
void printArray(float* arr, int size) {
    for (int i = 0; i < size; i++) {
        cout << arr[i] << " ";
    }
    cout << endl;
}

int main() {
    // ===== 1 =====
    cout << "1) Динамічні змінні:\n";

    int* a = new int;
    double* b = new double;
    char* c = new char;

    cout << "Введіть int, double, char:\n";
    cin >> *a >> *b >> *c;

    cout << "Ви ввели: " << *a << " " << *b << " " << *c << endl;

    delete a;
    delete b;
    delete c;

    // ===== 2 =====
    cout << "\n2) Вказівник на double:\n";

    double* d = new double;
    cout << "Введіть значення: ";
    cin >> *d;

    cout << "Значення: " << *d << endl;

    delete d;

    // ===== 3 =====
    cout << "\n3) Динамічний масив int:\n";

    int n;
    cout << "Розмір масиву: ";
    cin >> n;

    int* arr = new int[n];

    cout << "Введіть елементи:\n";
    for (int i = 0; i < n; i++) {
        cin >> arr[i];
    }

    cout << "У зворотному порядку:\n";
    for (int i = n - 1; i >= 0; i--) {
        cout << arr[i] << " ";
    }
    cout << endl;

    delete[] arr;

    // ===== 4 =====
    cout << "\n4) Динамічний масив float (random):\n";

    srand(time(0));

    int m;
    cout << "Розмір масиву: ";
    cin >> m;

    float* arr2 = new float[m];

    for (int i = 0; i < m; i++) {
        arr2[i] = (rand() % 100) / 10.0; // випадкові числа
    }

    cout << "Масив:\n";
    printArray(arr2, m);

    delete[] arr2;

    return 0;
}
