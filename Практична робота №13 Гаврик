#include <iostream>
#include <cstdlib>
#include <ctime>

using namespace std;

int main()
{
    srand(time(0));

    int n;
    cout << "Введіть розмір масиву: ";
    cin >> n;

    int a[100];

    cout << "Масив:" << endl;

    for(int i = 0; i < n; i++)
    {
        a[i] = rand() % 100;
        cout << a[i] << " ";
    }

    cout << endl;

    int vibir;

    cout << "Перевірити:" << endl;
    cout << "1 - на зростання" << endl;
    cout << "2 - на спадання" << endl;
    cin >> vibir;

    bool ok = true;

    if(vibir == 1)
    {
        for(int i = 0; i < n - 1; i++)
        {
            if(a[i] > a[i + 1])
            {
                ok = false;
                break;
            }
        }

        if(ok)
            cout << "Масив зростає.";
        else
            cout << "Масив НЕ зростає.";
    }

    else if(vibir == 2)
    {
        for(int i = 0; i < n - 1; i++)
        {
            if(a[i] < a[i + 1])
            {
                ok = false;
                break;
            }
        }

        if(ok)
            cout << "Масив спадає.";
        else
            cout << "Масив НЕ спадає.";
    }

    else
    {
        cout << "Невірний вибір.";
    }

    return 0;
}
