#include <iostream>
#include <stdexcept>

using namespace std;

class Vector
{
private:
    int* data;
    int size;
    int capacity;

    void resize()
    {
        capacity *= 2;

        int* newData = new int[capacity];

        for (int i = 0; i < size; i++)
            newData[i] = data[i];

        delete[] data;
        data = newData;
    }

public:
    Vector()
    {
        size = 0;
        capacity = 2;
        data = new int[capacity];
    }

    ~Vector()
    {
        delete[] data;
    }

    void pushBack(int value)
    {
        if (size == capacity)
            resize();

        data[size] = value;
        size++;
    }

    void insert(int index, int value)
    {
        if (index < 0 || index > size)
            throw out_of_range("Невірний індекс!");

        if (size == capacity)
            resize();

        for (int i = size; i > index; i--)
            data[i] = data[i - 1];

        data[index] = value;
        size++;
    }

    void remove(int index)
    {
        if (index < 0 || index >= size)
            throw out_of_range("Невірний індекс!");

        for (int i = index; i < size - 1; i++)
            data[i] = data[i + 1];

        size--;
    }

    int get(int index)
    {
        if (index < 0 || index >= size)
            throw out_of_range("Невірний індекс!");

        return data[index];
    }

    int getSize()
    {
        return size;
    }

    int getCapacity()
    {
        return capacity;
    }

    void print()
    {
        if (size == 0)
        {
            cout << "Вектор порожній!" << endl;
            return;
        }

        cout << "Вектор: ";

        for (int i = 0; i < size; i++)
            cout << data[i] << " ";

        cout << endl;
    }
};

int main()
{
    Vector vec;
    int choice;

    do
    {
        cout << "\n========== МЕНЮ ВЕКТОРА ==========\n";
        cout << "1 - Додати елемент у кінець\n";
        cout << "2 - Вставити елемент за індексом\n";
        cout << "3 - Видалити елемент за індексом\n";
        cout << "4 - Отримати елемент за індексом\n";
        cout << "5 - Отримати кількість елементів\n";
        cout << "6 - Отримати розмір буфера\n";
        cout << "7 - Вивести вектор\n";
        cout << "0 - Вихід\n";
        cout << "Ваш вибір: ";

        cin >> choice;

        try
        {
            switch (choice)
            {
            case 1:
            {
                int value;
                cout << "Введіть значення: ";
                cin >> value;
                vec.pushBack(value);
                break;
            }

            case 2:
            {
                int index, value;
                cout << "Введіть індекс: ";
                cin >> index;
                cout << "Введіть значення: ";
                cin >> value;
                vec.insert(index, value);
                break;
            }

            case 3:
            {
                int index;
                cout << "Введіть індекс: ";
                cin >> index;
                vec.remove(index);
                break;
            }

            case 4:
            {
                int index;
                cout << "Введіть індекс: ";
                cin >> index;
                cout << "Елемент = " << vec.get(index) << endl;
                break;
            }

            case 5:
                cout << "Кількість елементів = " << vec.getSize() << endl;
                break;

            case 6:
                cout << "Розмір буфера = " << vec.getCapacity() << endl;
                break;

            case 7:
                vec.print();
                break;

            case 0:
                cout << "Програму завершено." << endl;
                break;

            default:
                cout << "Невірний вибір!" << endl;
            }
        }
        catch (exception& e)
        {
            cout << "Помилка: " << e.what() << endl;
        }

    } while (choice != 0);

    return 0;
}
